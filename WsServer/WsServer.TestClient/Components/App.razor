@using System.Net.WebSockets
@using RazorConsole.Components
@using WsServer.TestClient.Services

<Columns>
	<Rows>
		<RoomsListSection ServerState="@serverState" />
		<ServerInfoSection ServerState="@serverState" />
	</Rows>

	<Panel Title="Chat">
		<Rows>
			<ChatSection ClientService="@clientService" />
			<CommandInputSection ClientService="@clientService" OnCommand="@HandleCommand" />
		</Rows>
	</Panel>

	<Panel Title="💡 Usage Tips">
		<Rows>
			<Markup Content="• join roomId - Join a room (e.g., join lobby)" />
			<Markup Content="• name name - Set player name (e.g., name Player1)" />
			<Markup Content="• chat message - Send chat message" />
			<Markup Content="• send text - Send raw text message" />
			<Markup Content="• exit - Disconnect and exit" />
		</Rows>
	</Panel>
</Columns>

@code {
	private WebSocketClientService clientService = null!;
	private ServerStateService serverState = null!;

	protected override async Task OnInitializedAsync()
	{
		clientService = new WebSocketClientService();
		serverState = new ServerStateService();
		serverState.Initialize();

		// Connect to server
		bool connected = await clientService.ConnectAsync("ws://localhost:5000/ws");
		if (connected)
		{
			serverState.UpdateStatus("Connected");
		}
	}

	private async Task HandleCommand(string command)
	{
		if (command.Equals("exit", StringComparison.OrdinalIgnoreCase))
		{
			await clientService.DisconnectAsync();
			Environment.Exit(0);
		}
		else
		{
			await clientService.SendTextAsync(command);
		}
	}
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameServer": {
    "TickIntervalMs": 33,
    "MaxDeltaTimeSeconds": 0.1,
    "SnapshotSendEveryTicks": 2,
    "FullSnapshotIntervalSeconds": 1.0,
    "SnapshotRepeatUnchanged": 2,
    "HealthMaxTickAgeSeconds": 5,
    "WebSocketBufferSize": 4096,
    "WebSocketMaxConsecutiveErrors": 10,
    "WebSocketMaxMessageSizeBytes": 65536,
    "WebSocketSendQueueCapacity": 1024,
    "WebSocketKeepAliveIntervalSeconds": 15,
    "WebSocketKeepAliveTimeoutSeconds": 15,
    "HeartbeatIntervalSeconds": 5,
    "ShootCooldownSeconds": 0.25,
    "ChatCooldownSeconds": 0.5,
    "MaxChatLength": 256,
    "MaxNameLength": 32,
    "ChatDatabasePath": "data/chat.db",
    "ChatHistoryPageSize": 50,
    "ChatHistoryCacheSize": 200,
    "ChatHistoryMaxMessagesPerRoom": 50000,
    "PresenceMaxOfflineUsers": 100,
    "UserRetentionDays": 90,
    "MaxKnownUsers": 10000,
    "PresenceFlushIntervalSeconds": 1.0
  }
}

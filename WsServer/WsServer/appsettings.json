{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameServer": {
    "TickIntervalMs": 33,
    "MaxDeltaTimeSeconds": 0.1,
    "WebSocketBufferSize": 4096,
    "WebSocketMaxConsecutiveErrors": 10,
    "WebSocketMaxMessageSizeBytes": 65536,
    "WebSocketSendQueueCapacity": 256,
    "ShootCooldownSeconds": 0.25,
    "ChatCooldownSeconds": 0.5,
    "MaxChatLength": 256,
    "MaxNameLength": 32
  }
}
